/*
THIS SHORT PROGRAM IS USED TO SHOW HOW UNDECLARED VARIABLES WORK

IF FIRST LETTER OF UNDECLARED VARIABLE IS:
BETWEEN I AND N THEN IT WILL BE AN INTEGER (FIXED BINARY)
BETWEEN A AND H , AND O AND Z, AND SYMBOLS @,#,$ -> SHORT FORM FLOATING-POINT FORMAT
*/
MAIN: PROCEDURE OPTIONS(MAIN);
	A = 20; /*out: A= 2.00000E+0001  */      
	B = 30; /*out: B= 3.00000E+0001  */
	PUT SKIP DATA(A,B);

	I = 20; /*out: I=       20       */        
	J = 30; /*out: J=       30       */ 
	PUT SKIP DATA(I,J);

	@X = 20; /*out: @X= 2.00000E+0001*/       

	#Y = 30; /*out: #Y= 3.00000E+0001*/ 
	PUT SKIP DATA(@X,#Y);
END MAIN;